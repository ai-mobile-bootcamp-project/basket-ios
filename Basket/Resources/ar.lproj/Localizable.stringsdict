			<key>two</key>
			<string>%lld عنصران</string>
			<key>zero</key>
			<string>%lld عنصر</string>
		</dict>
	</dict>
	<key>detail.withoutPrice</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld عناصر بدون سعر</string>
