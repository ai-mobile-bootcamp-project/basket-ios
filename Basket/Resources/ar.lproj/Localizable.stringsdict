			<key>other</key>
			<string>%lld عنصر بدون سعر</string>
			<key>two</key>
			<string>%lld عنصران بدون سعر</string>
			<key>zero</key>
			<string>%lld عنصر بدون سعر</string>
		</dict>
	</dict>
	<key>form.duplicate.addMore</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>إضافة %lld أخرى</string>
